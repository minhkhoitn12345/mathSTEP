# Supabase URL and publishable key for Auth verification and RLS-protected reads.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Server-only key used by FastAPI to write chat turns. Never expose to Next.js/browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# OpenAI-compatible provider. Store the real key in the API host's secret settings.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-with-provider-secret
AI_MODEL=replace-with-model-id
LLM_TIMEOUT_SECONDS=45

# Set true only when teacher policy explicitly permits full worked solutions.
ALLOW_FULL_SOLUTIONS=false

# When true, the server overrides any client-supplied mode to assessment.
FORCE_ASSESSMENT_MODE=false
