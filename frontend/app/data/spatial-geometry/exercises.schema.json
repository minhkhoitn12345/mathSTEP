{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathstep-vn.vercel.app/schemas/spatial-geometry-problem.schema.json",
  "title": "MathSTEP spatial geometry problem",
  "type": "object",
  "required": ["problemMetadata", "sceneConfig", "geometry", "pedagogy"],
  "properties": {
    "problemMetadata": {
      "type": "object",
      "required": ["title", "gradeLevel", "topic", "originalText"],
      "properties": {
        "title": { "type": "string" },
        "gradeLevel": { "type": "string" },
        "topic": { "type": "string" },
        "originalText": { "type": "string" }
      }
    },
    "sceneConfig": {
      "type": "object",
      "required": ["cameraPosition", "target"],
      "properties": {
        "cameraPosition": { "$ref": "#/$defs/vector3" },
        "target": { "$ref": "#/$defs/vector3" }
      }
    },
    "geometry": {
      "type": "object",
      "required": ["type", "vertices", "solidEdges", "dashedEdges", "faces"],
      "properties": {
        "type": { "type": "string", "enum": ["pyramid", "prism", "cylinder", "cone", "sphere"] },
        "vertices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "coords"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "coords": { "$ref": "#/$defs/vector3" }
            }
          }
        },
        "solidEdges": { "$ref": "#/$defs/edges" },
        "dashedEdges": { "$ref": "#/$defs/edges" },
        "faces": { "type": "array", "items": { "type": "array", "items": { "type": "string" }, "minItems": 3 } },
        "heightLine": {
          "type": "object",
          "required": ["start", "end", "hasRightAngleMark"],
          "properties": { "start": { "type": "string" }, "end": { "type": "string" }, "hasRightAngleMark": { "type": "boolean" } }
        },
        "angleMarker": {
          "type": "object",
          "required": ["vertex", "firstRay", "secondRay", "label"],
          "properties": { "vertex": { "type": "string" }, "firstRay": { "type": "string" }, "secondRay": { "type": "string" }, "label": { "type": "string" } }
        }
      }
    },
    "pedagogy": {
      "type": "object",
      "required": ["level1_Identify", "socraticHints"],
      "properties": {
        "level1_Identify": {
          "type": "object",
          "required": ["question", "targetNodeId", "successExplanation"],
          "properties": { "question": { "type": "string" }, "targetNodeId": { "type": "string" }, "successExplanation": { "type": "string" } }
        },
        "level2_Construction": {
          "type": "object",
          "required": ["question", "cutPlaneEquation", "expectedPolygonType", "crossSectionVertices"],
          "properties": {
            "question": { "type": "string" },
            "cutPlaneEquation": { "type": "string" },
            "expectedPolygonType": { "type": "string" },
            "crossSectionVertices": { "type": "array", "items": { "type": "string" } },
            "requiredNodeIds": { "type": "array", "items": { "type": "string" } }
          }
        },
        "level3_ParametricSlider": {
          "type": "object",
          "required": ["parameter", "min", "max", "step", "formulaLatex", "targetRatio"],
          "properties": {
            "parameter": { "type": "string" },
            "min": { "type": "number" },
            "max": { "type": "number" },
            "step": { "type": "number", "exclusiveMinimum": 0 },
            "formulaLatex": { "type": "string" },
            "targetRatio": { "type": "number", "minimum": 0 }
          }
        },
        "socraticHints": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "vector3": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }], "minItems": 3, "maxItems": 3 },
    "edges": { "type": "array", "items": { "type": "array", "prefixItems": [{ "type": "string" }, { "type": "string" }], "minItems": 2, "maxItems": 2 } }
  }
}
