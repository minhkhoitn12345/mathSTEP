# Supabase project public URL and publishable/anon key. Keep values server-side in this app.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Public application origin used to build auth callback URLs behind reverse proxies.
APP_BASE_URL=https://mathstep.click

# FastAPI URL. Local development uses the local API process.
FASTAPI_BASE_URL=http://127.0.0.1:8000

# Stable server-only HMAC key for email login/signup math CAPTCHA tokens.
# Generate at least 32 random characters and configure the same value in every deployment.
CAPTCHA_SECRET=

# Optional server-only code (32+ random characters) for granting a signed, short-lived teacher session.
# No default is provided; leave empty to disable teacher-code activation.
TEACHER_ACCESS_CODE=
